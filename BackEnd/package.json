{
  "name": "msp-backend",
  "version": "1.0.0",
  "description": "MSP Design — NestJS REST API (projects, team, blog, CMS, auth)",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/seed.ts",
    "classify:projects": "ts-node -r tsconfig-paths/register src/database/seeds/classify-projects.ts",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\"",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "migration:show:prod": "typeorm migration:show -d dist/database/data-source.js",
    "migration:baseline": "ts-node -r tsconfig-paths/register src/database/mark-baseline.ts",
    "migration:baseline:prod": "node dist/database/mark-baseline.js",
    "seed:vendors": "ts-node -r tsconfig-paths/register src/database/seeds/seed-vendors.ts",
    "vendor:typeorm": "typeorm-ts-node-commonjs -d src/database/vendor-data-source.ts",
    "vendor:migration:generate": "npm run vendor:typeorm -- migration:generate",
    "vendor:migration:run": "npm run vendor:typeorm -- migration:run",
    "vendor:migration:show": "npm run vendor:typeorm -- migration:show",
    "vendor:migration:run:prod": "typeorm migration:run -d dist/database/vendor-data-source.js",
    "vendor:migration:show:prod": "typeorm migration:show -d dist/database/vendor-data-source.js",
    "vendor:seed": "ts-node -r tsconfig-paths/register src/database/seeds/seed-vendors.ts",
    "vendor:start:prod": "node dist/vendor-service.main.js",
    "vendor:start:dev": "ts-node -r tsconfig-paths/register src/vendor-service.main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.2.0",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
