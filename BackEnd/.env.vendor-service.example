# ===== MSP Vendor Service (OFFICE host) — copy to .env next to the service =====
NODE_ENV=production
PORT=3100
LISTEN_HOST=127.0.0.1            # only cloudflared (same machine) talks to it
API_PREFIX=api
CORS_ORIGIN=https://www.msp.sa,https://msp.sa

# Its OWN PostgreSQL database on the office host (never the website's)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=msp_vendor
DB_PASSWORD=<set on the host>
DB_NAME=msp_vendor
DB_SCHEMA=public
DB_SYNCHRONIZE=false

# Pending documents (drafts / under review). Outside the approved archive.
VENDOR_DOCS_DIR=D:\MSP-VendorService\documents

# Vendor sessions — a secret of this service only (32+ random chars)
VENDOR_JWT_SECRET=<set on the host>
VENDOR_TOKEN_TTL=12h

# Staff tokens issued by the website: PUBLIC key only. No JWT_PRIVATE_KEY here, ever.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=msp-website
JWT_AUDIENCE=msp-admin,vendor-service
# JWT_SECRET is NOT needed in production (HS256 dev fallback only)

# Links in e-mails
PUBLIC_URL=https://www.msp.sa

# Notifications: recipient of new/updated applications (independent of the sending account)
VENDOR_REVIEW_INBOX=supply@msp.sa
# Sending account — configured separately; leave SMTP_HOST empty to write .eml files instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MSP Vendor Portal <no-reply@msp.sa>
MAIL_REPLY_TO=supply@msp.sa       # vendors who hit "reply" reach the team
MAIL_OUTBOX_DIR=D:\MSP-VendorService\mail-outbox
