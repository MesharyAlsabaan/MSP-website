# Secrets — never commit real environment files
.env
.env.*
!.env.example

# Playwright MCP debug artifacts
.playwright-mcp/

# OS / editor noise
.DS_Store
Thumbs.db

# Dependencies & build output (also covered by sub-project .gitignore files)
node_modules/
dist/

# Local data export for the server (DB dump + uploaded images) — never commit
deploy/

# Large binary source assets — keep on disk / Drive, never in git
BRANDING/
*.pdf
*.psd
*.ai
*.indd
*.tif
*.tiff
