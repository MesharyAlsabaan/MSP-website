# Secrets — never commit real environment files
.env
.env.*
!.env.example

# Playwright MCP debug artifacts
.playwright-mcp/

# OS / editor noise
.DS_Store
Thumbs.db

# Dependencies & build output (also covered by sub-project .gitignore files)
node_modules/
dist/

# Local data export for the server (DB dump + uploaded images) — never commit
deploy/*
!deploy/office/

# Large binary source assets — keep on disk / Drive, never in git
BRANDING/
*.pdf
*.psd
*.ai
*.indd
*.tif
*.tiff

# Vendor documents, local mail outbox (never committed)
BackEnd/vendor-docs/
BackEnd/mail-outbox/
vendor-docs/
mail-outbox/
ArchiveAgent/test-archive/
ArchiveAgent/state/
ArchiveAgent/logs/
ArchiveAgent/config.json

# Office deployment templates are code, not data
!BackEnd/.env.vendor-service.example
