server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # nginx builds redirects from `listen`, so a directory redirect would send
  # visitors to http://host:8080/path/ — leaking the internal port and dropping
  # TLS. Relative redirects keep the scheme, host and port the visitor came in on.
  absolute_redirect off;

  # One canonical host: the apex redirects to www (canonicals, hreflang and
  # the sitemap all use https://www.msp.sa). Exact match, so Railway's
  # internal hostnames and health checks are unaffected.
  if ($host = msp.sa) {
    return 301 https://www.msp.sa$request_uri;
  }

  client_max_body_size 10M;
  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_types text/css text/plain application/javascript application/json
             image/svg+xml application/manifest+json application/xml;

  # Angular fingerprints every build asset (main-<hash>.js, styles-<hash>.css),
  # so a given URL's bytes never change — cache them for a year and skip the
  # revalidation round-trip on every repeat visit and navigation. This is the
  # single biggest load-time win; without it the browser re-fetched all JS,
  # CSS, fonts and images each time.
  location ~* \.(?:js|mjs|css|woff2?|ttf|otf|eot|jpg|jpeg|png|webp|avif|gif|svg|ico|mp4)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    access_log off;
    try_files $uri =404;
  }

  # API, Swagger and uploaded files -> NestJS backend.
  # BACKEND_URL is env-configurable (Docker Compose: http://backend:3000,
  # Railway: http://<service>.railway.internal:3000). Using a variable in
  # proxy_pass forces nginx to re-resolve DNS, so backend redeploys with new
  # IPs keep working without restarting this container.
  # `^~` so this beats the static-asset regex below: uploaded files like
  # /api/uploads/x.webp must be proxied to the backend, not looked up on the
  # local static root (which 404s). Regex locations otherwise win over prefixes.
  location ^~ /api/ {
    resolver ${DNS_RESOLVER} valid=10s;
    set $api_upstream ${BACKEND_URL};
    proxy_pass         $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
  }

  # One URL form, without a trailing slash, matching the canonical links:
  # /about/ → /about. (A regex, so it runs before the prefix locations below;
  # /api/ is exempt because `^~` prefixes beat regexes.)
  location ~ ^(.+)/$ {
    return 301 $1$is_args$args;
  }

  # Old project URL → the project's current slug. A real 301, not the meta
  # refresh Angular writes for a router redirect.
  location ~ ^/(ar/)?projects/sbc-commercial-office$ {
    return 301 /$1projects/SBC;
  }

  # Placeholder content that is still published in the CMS but excluded from
  # the site (src/app/core/data/excluded-content.ts): a real 404, so search
  # engines drop it.
  location = /blog/designing-for-the-desert {
    error_page 404 /404/index.html;
    return 404;
  }
  location = /ar/blog/designing-for-the-desert {
    error_page 404 /ar/404/index.html;
    return 404;
  }

  # Sector pages exist only when prerendered (enough projects in the sector);
  # any other sector URL is a real 404, not an empty app shell.
  location ~ ^/projects/sector/[^/]+$ {
    add_header Cache-Control "no-cache";
    error_page 404 /404/index.html;
    try_files $uri/index.html =404;
  }
  location ~ ^/ar/projects/sector/[^/]+$ {
    add_header Cache-Control "no-cache";
    error_page 404 /ar/404/index.html;
    try_files $uri/index.html =404;
  }

  # Static Angular site. Prerendered routes resolve to their own index.html;
  # client-rendered routes (/admin, /auth) fall back to the app shell.
  #
  # That shell is index.csr.html, NOT index.html: the latter is the prerendered
  # home page, so serving it for /auth/login handed the browser a fully rendered
  # homepage, which Angular then hydrated as the home route and left on screen.
  #
  # Only the client-rendered routes get the shell. They're dynamic (slugs,
  # tokens, auth), so the server can't know whether they exist — the app shows
  # its own not-found view. Prerendered pages under these prefixes (every
  # project and insight published at build time) still win via
  # $uri/index.html; only slugs published since the last deploy get the shell.
  #
  # Pages are looked up as $uri/index.html rather than $uri/ so nginx serves
  # /about directly instead of redirecting to /about/.
  location ~ ^/(ar/)?(admin|auth|vendors|projects/[^/]+|blog/[^/]+)(/|$) {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/index.html /index.csr.html;
  }

  # Arabic edition: unknown /ar/... paths get the Arabic 404 page.
  location /ar/ {
    add_header Cache-Control "no-cache";
    error_page 404 /ar/404/index.html;
    try_files $uri $uri/index.html =404;
  }

  # Everything else is a prerendered page or a static file. Anything not on
  # disk is a real 404 (status 404, not a 200 app shell that search engines
  # index as a duplicate home page).
  location / {
    # HTML must revalidate so a new deploy is picked up at once, even though
    # the hashed assets it points to are cached hard above.
    add_header Cache-Control "no-cache";
    error_page 404 /404/index.html;
    try_files $uri $uri/index.html =404;
  }
}
