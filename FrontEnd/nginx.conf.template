server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # nginx builds redirects from `listen`, so a directory redirect would send
  # visitors to http://host:8080/path/ — leaking the internal port and dropping
  # TLS. Relative redirects keep the scheme, host and port the visitor came in on.
  absolute_redirect off;

  client_max_body_size 10M;
  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_types text/css text/plain application/javascript application/json
             image/svg+xml application/manifest+json application/xml;

  # Angular fingerprints every build asset (main-<hash>.js, styles-<hash>.css),
  # so a given URL's bytes never change — cache them for a year and skip the
  # revalidation round-trip on every repeat visit and navigation. This is the
  # single biggest load-time win; without it the browser re-fetched all JS,
  # CSS, fonts and images each time.
  location ~* \.(?:js|mjs|css|woff2?|ttf|otf|eot|jpg|jpeg|png|webp|avif|gif|svg|ico|mp4)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    access_log off;
    try_files $uri =404;
  }

  # API, Swagger and uploaded files -> NestJS backend.
  # BACKEND_URL is env-configurable (Docker Compose: http://backend:3000,
  # Railway: http://<service>.railway.internal:3000). Using a variable in
  # proxy_pass forces nginx to re-resolve DNS, so backend redeploys with new
  # IPs keep working without restarting this container.
  location /api/ {
    resolver ${DNS_RESOLVER} valid=10s;
    set $api_upstream ${BACKEND_URL};
    proxy_pass         $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
  }

  # Static Angular site. Prerendered routes resolve to their own index.html;
  # client-rendered routes (/admin, /auth) fall back to the app shell.
  #
  # That shell is index.csr.html, NOT index.html: the latter is the prerendered
  # home page, so serving it for /auth/login handed the browser a fully rendered
  # homepage, which Angular then hydrated as the home route and left on screen.
  location / {
    # HTML (prerendered pages + the app shell) must revalidate so a new deploy
    # is picked up at once, even though the hashed assets it points to are
    # cached hard above.
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.csr.html;
  }
}
