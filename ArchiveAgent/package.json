{
  "name": "msp-archive-agent",
  "version": "0.1.0",
  "private": true,
  "description": "MSP office service: pulls approved vendor applications from the website and archives them into the company network folders and Excel registers.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "once": "node dist/main.js --once",
    "dev": "ts-node src/main.ts --once",
    "test": "jest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*.spec.ts$",
    "transform": {
      "^.+.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  }
}
